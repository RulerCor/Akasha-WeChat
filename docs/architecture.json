  "cards": [
    {
      "dot": "cyan",
      "title": "主链路",
      "items": [
        "WeFlow 解密本地消息库后 SSE 推送，不轮询、不依赖窗口渲染",
        "桥接做缓冲合并、多层去重、策略过滤，再构造 OneBot v11 事件",
        "AstrBot 产出回复后回调 send_msg，桥接用 UIA 写回微信窗口"
      ]
    },
    {
      "dot": "emerald",
      "title": "RC 分支的关键修复",
      "items": [
        "输入框按类名 ChatInputField 定位：消息不再被写进搜索框",
        "发送按钮改为 XOutlineButton：不再出现「填进输入框却不发送」",
        "会话 ID 改用 MD5：重启不再产生重复会话（原 hash 每进程随机）",
        "群名走持久化缓存：不再把 chatroom 原始 ID 当群名显示"
      ]
    },
    {
      "dot": "amber",
      "title": "能力边界",
      "items": [
        "WeFlow 只有读取能力，发送必须依赖 UIA 自动化",
        "群成员名单与人数取不到，只读接口只返回发过言的成员",
        "图片理解交给 AstrBot：转述模型留空则主模型直接看图"
      ]
    }
  ]

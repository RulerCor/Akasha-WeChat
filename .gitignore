# ===== 本机配置（含 WeFlow access_token，绝不入库）=====
config.json

# ===== 运行时产物 =====
data/
*.log
bridge.pid
bridge_run.log
wechat_images/

# ===== Python =====
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# ===== 编辑器 / 系统 =====
.vscode/
.idea/
.DS_Store
Thumbs.db

# ===== 架构图校验中间产物（保留 architecture.json / architecture.html）=====
docs/architecture.visual-check.*

# ===== sim 模拟器运行产物 =====
sim/data/
sim/*.log
sim/模拟对话测试报告.md
__pycache__/

# ===== 本地运行环境（桥接 + AstrBot，含 venv 与业务数据，绝不入库）=====
runtime/

# ===== 随项目走的第三方依赖（基座 Python、WeFlow 程序本体；约 750MB，不入库）=====
# 说明见 docs/依赖与目录说明.md。放这里是为了让开发文件夹自包含：
# 两个 venv 的 pyvenv.cfg 都指向 vendor/python，不再依赖 WorkBuddy 自带环境。
vendor/

# ===== 发布产物（用 scripts/build_release.py / build_dist.py 生成，不入库）=====
release/

# ===== 安装包源码目录（WeFlow / 微信 的 exe，体积大且非本仓库代码，不入库）=====
# 构建时由 build_dist.py 收录进发行版；放这里是为了让出包流程有个固定入口。
installers_src/
scripts/installers_src/
